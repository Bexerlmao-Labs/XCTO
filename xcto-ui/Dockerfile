# ============================================================
# XCTO 前端镜像 —— 静态文件载体（不含任何 Web 服务器）
# ============================================================
# 镜像内只有 Vite 编译产物，没有任何常驻进程。
# 部署时由 docker-compose 编排为一次性容器：启动后把文件拷贝到
# 宿主机 webroot（bind mount 到 /webroot）即退出，
# 页面由宿主机 nginx（宝塔）直接从磁盘托管。
# ============================================================

FROM busybox:1.36
WORKDIR /dist
COPY dist/ /dist/
