# ============================================================
# XCTO 环境变量模板（docker compose 自动读取）
# 使用方式：复制本文件为 .env 并按需修改
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 注意：.env 含真实密码，已被 .gitignore 忽略，切勿提交到仓库
# ============================================================

# ---- 外部 PostgreSQL（由 script/docker-compose.database.yml 编排，容器名 postgres） ----
# 数据库主机：compose 部署时为容器名 postgres；本地 IDE 直跑可改 localhost
DB_HOST=postgres
# 数据库名（URL 中的库名）
DB_NAME=xcto
# 数据库账号/密码
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# ---- Redis（compose 内服务，默认账号 default） ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=redis123456
